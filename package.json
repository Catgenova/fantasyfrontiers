{
  "name": "fantasyfrontiers-build",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Deploy-time obfuscation build for Fantasy Frontiers. index.html stays readable in the repo; GitHub Pages serves an obfuscated build produced by this pipeline.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "typecheck:functions": "node scripts/typecheck-functions.mjs",
    "test:functions": "node scripts/test-save-uniques.mjs",
    "sqlcheck": "node scripts/sqlcheck.mjs",
    "artcheck": "node scripts/artcheck.mjs",
    "art:optimize": "node scripts/artoptimize.mjs",
    "seamcheck": "node scripts/seamcheck.mjs",
    "demo:orb": "node scripts/inline-orb-demo.mjs",
    "demo:arena": "node scripts/inline-demo.mjs demo/arena.html"
  },
  "devDependencies": {
    "javascript-obfuscator": "^4.1.1",
    "playwright": "^1.48.0",
    "sharp": "^0.35.3",
    "typescript": "^5.6.3"
  }
}
